<UserControl
    x:Class="ImageCropper.Views.UserControls.PrefixTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 挿入ボタンのモダンでプレミアムなスタイル -->
        <Style x:Key="InsertBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrefixButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrefixButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrefixButtonHoverBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrefixButtonHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrefixButtonPressedBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RichTextBoxのスタイル設定 (通常のTextBoxのように見せる) -->
        <Style x:Key="ModernRichTextBox" TargetType="RichTextBox">
            <Setter Property="Background" Value="{DynamicResource PrefixRichTextBoxBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrefixRichTextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrefixRichTextBoxFocusBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 変数挿入用ツールバー -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="変数挿入：" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrefixLabelForegroundBrush}"/>
            <Button Style="{StaticResource InsertBtnStyle}" Click="InsertFileName_Click">
                <TextBlock Text="ファイル名" Foreground="{DynamicResource FileNameVariableBrush}" FontSize="11" FontWeight="Bold"/>
            </Button>
            <Button Style="{StaticResource InsertBtnStyle}" Click="InsertDateTime_Click">
                <TextBlock Text="作成日時" Foreground="{DynamicResource DateVariableBrush}" FontSize="11" FontWeight="Bold"/>
            </Button>
            <Button Style="{StaticResource InsertBtnStyle}" Click="InsertIndex_Click">
                <TextBlock Text="インデックス" Foreground="{DynamicResource IndexVariableBrush}" FontSize="11" FontWeight="Bold"/>
            </Button>
        </WrapPanel>

        <!-- リッチテキストエディタ本体 -->
        <RichTextBox Grid.Row="1"
                     x:Name="MainRichTextBox"
                     Style="{StaticResource ModernRichTextBox}"
                     PreviewKeyDown="MainRichTextBox_PreviewKeyDown"
                     TextChanged="MainRichTextBox_TextChanged"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Disabled">
            <FlowDocument PagePadding="0" AllowDrop="False">
                <Paragraph Margin="0" />
            </FlowDocument>
        </RichTextBox>
    </Grid>
</UserControl>
